[Unit]
Description=Kyoto Bounce game and authoritative physics
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=kyoto
Group=kyoto
WorkingDirectory=/opt/kyoto/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/kyoto.env
ExecStart=/usr/local/bin/node web/server.ts
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kyoto /var/log/kyoto
MemoryHigh=2500M
MemoryMax=3G
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
